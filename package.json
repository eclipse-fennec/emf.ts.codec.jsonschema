{
  "name": "@emfts/codec.jsonschema",
  "version": "0.0.1-next.1",
  "description": "JSON Schema codec for emf.ts - bidirectional conversion between JSON Schema and EMF metamodels",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
