    "test:run": "vitest run"
  },
  "keywords": [
    "emf",
    "json-schema",
    "codec",
    "ecore",
    "typescript"
  ],
  "author": "",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-fennec/emf.ts.codec.jsonschema"
  },
  "peerDependencies": {
    "@emfts/core": "^0.1.0"
  },
  "devDependencies": {
    "@emfts/core": "^0.1.1-next.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "20.19.4"
  }
